# Copy to .env for local development.  ── DO NOT COMMIT the real .env ──

# Path to the Firebase service-account key JSON (local dev only).
# In Cloud Run this is mounted at /secrets/FIREBASE_KEY instead.
FIREBASE_KEY_PATH=./firebase_key.json

# Firebase Storage bucket used to store processed images.
STORAGE_BUCKET_NAME=identityverifierapp.firebasestorage.app

# CORS: comma-separated extra origins allowed to call the API.
# Defaults already include robles.ai + localhost; add others here if needed.
ALLOWED_ORIGINS=

# Optional API key. If set, every request must send header  X-API-Key: <value>.
# Leave EMPTY to disable auth (default) so the current frontend keeps working.
API_KEY=

# Anti-SSRF: comma-separated extra hosts allowed for server-side image fetch.
# Defaults already include firebasestorage.googleapis.com + storage.googleapis.com.
ALLOWED_IMAGE_HOSTS=

# Timeout (seconds) for outbound image downloads.
IMAGE_FETCH_TIMEOUT=15

# Seconds after which a stuck cron lock is considered stale and reclaimed.
CRON_LOCK_STALE_SECONDS=600

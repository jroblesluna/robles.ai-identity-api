# Copy to .env for local development.  ── DO NOT COMMIT the real .env ──
#
# This service no longer uses Firebase. The async request queue is in-process
# (app/services/store.py) and images are exchanged as base64 — there is no
# external datastore or storage bucket to configure.

# CORS: comma-separated extra origins allowed to call the API.
# Defaults already include robles.ai + localhost; add others here if needed.
ALLOWED_ORIGINS=

# Optional API key. If set, every request must send header  X-API-Key: <value>.
# Leave EMPTY to disable auth (default) so the current frontend keeps working.
API_KEY=

# Anti-SSRF: comma-separated extra hosts allowed for server-side image fetch.
# (read_image_from_url is kept as a generic helper; input images now arrive as
# base64, so this is only relevant if you re-enable URL-based fetching.)
ALLOWED_IMAGE_HOSTS=

# Timeout (seconds) for outbound image downloads (only used by read_image_from_url).
IMAGE_FETCH_TIMEOUT=15
